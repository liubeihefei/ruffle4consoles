+/// Decodes only a requested rectangle from a large JPEG3 bitmap. This keeps
+/// Vita from allocating the full RGBA image when ActionScript immediately
+/// extracts one animation frame from a sprite sheet.
+#[cfg(target_os = "vita")]
+pub fn decode_define_bits_jpeg3_region(
+    jpeg_data: &[u8],
+    alpha_data: &[u8],
+    width: u32,
+    height: u32,
+    region: PixelRegion,
+    flip_x: bool,
+) -> Result<Bitmap<'static>, Error> {
+    if region.x_max > width || region.y_max > height {
+        return Err(Error::InvalidSize);
+    }
+
+    let jpeg_data = remove_invalid_jpeg_data(jpeg_data);
+    let mut decoder = jpeg_decoder::Decoder::new(&jpeg_data[..]);
+    decoder.read_info()?;
+    let metadata = decoder
+        .info()
+        .expect("info() should always be Some if read_info returned Ok");
+    if metadata.pixel_format != jpeg_decoder::PixelFormat::RGB24
+        || u32::from(metadata.width) != width
+        || u32::from(metadata.height) != height
+    {
+        return Err(Error::InvalidJpeg(jpeg_decoder::Error::Format(
+            "JPEG3 region decode requires an RGB image with matching dimensions".to_owned(),
+        )));
+    }
+
+    let mut alpha_decoder = flate2::bufread::ZlibDecoder::new(alpha_data);
+    let mut alpha_row = vec![0; width as usize];
+    let mut rgba = vec![0; region.width() as usize * region.height() as usize * 4];
+    let mut alpha_decode_failed = false;
+
+    decoder.decode_rows(|row, rgb_row| {
+        if alpha_decode_failed {
+            return Ok(());
+        }
+        if alpha_decoder.read_exact(&mut alpha_row).is_err() {
+            alpha_decode_failed = true;
+            return Ok(());
+        }
+        let row = row as u32;
+        if row < region.y_min || row >= region.y_max {
+            return Ok(());
+        }
+
+        let output_y = (row - region.y_min) as usize;
+        for output_x in 0..region.width() {
+            let logical_x = region.x_min + output_x;
+            let source_x = if flip_x {
+                width - 1 - logical_x
+            } else {
+                logical_x
+            } as usize;
+            let rgb_offset = source_x * 3;
+            let rgba_offset = (output_y * region.width() as usize + output_x as usize) * 4;
+            let alpha = alpha_row[source_x];
+            rgba[rgba_offset] = rgb_row[rgb_offset].min(alpha);
+            rgba[rgba_offset + 1] = rgb_row[rgb_offset + 1].min(alpha);
+            rgba[rgba_offset + 2] = rgb_row[rgb_offset + 2].min(alpha);
+            rgba[rgba_offset + 3] = alpha;
+        }
+        Ok(())
+    })?;
+
+    let mut trailing_alpha = [0u8; 1];
+    let trailing_alpha_bytes = alpha_decoder
+        .read(&mut trailing_alpha)
+        .map_err(|_| Error::InvalidZlibCompression)?;
+    if alpha_decode_failed || trailing_alpha_bytes != 0 {
+        return Err(Error::InvalidZlibCompression);
+    }
+
+    tracing::info!(
+        "VITA_JPEG_REGION_OK source={}x{} region={},{},{}x{} flip_x={} decoded_bytes={}",
+        width,
+        height,
+        region.x_min,
+        region.y_min,
+        region.width(),
+        region.height(),
+        flip_x,
+        rgba.len(),
+    );
+    Ok(Bitmap::new(
+        region.width(),
+        region.height(),
+        BitmapFormat::Rgba,
+        rgba,
+    ))
+}
