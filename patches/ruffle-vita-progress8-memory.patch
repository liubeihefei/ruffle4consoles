+/// Decodes only a requested rectangle from a DefineBitsLossless bitmap.
+#[cfg(target_os = "vita")]
+pub fn decode_define_bits_lossless_region(
+    swf_tag: &swf::DefineBitsLossless,
+    region: PixelRegion,
+    flip_x: bool,
+) -> Result<Bitmap<'static>, Error> {
+    let width = u32::from(swf_tag.width);
+    let height = u32::from(swf_tag.height);
+    if region.x_max > width || region.y_max > height {
+        return Err(Error::InvalidSize);
+    }
+    validate_size(swf_tag.width, swf_tag.height)?;
+
+    let has_alpha = swf_tag.version == 2;
+    let mut decoder = flate2::bufread::ZlibDecoder::new(&swf_tag.data[..]);
+    let mut rgba = Vec::with_capacity(region.width() as usize * region.height() as usize * 4);
+
+    match (swf_tag.version, swf_tag.format) {
+        (1, swf::BitmapFormat::Rgb15) => {
+            let padded_width = (width + 1) & !1;
+            let mut row = vec![0; padded_width as usize * 2];
+            for y in 0..height {
+                decoder
+                    .read_exact(&mut row)
+                    .map_err(|_| Error::InvalidZlibCompression)?;
+                if y < region.y_min || y >= region.y_max {
+                    continue;
+                }
+                for output_x in 0..region.width() {
+                    let logical_x = region.x_min + output_x;
+                    let source_x = if flip_x { width - 1 - logical_x } else { logical_x };
+                    let offset = source_x as usize * 2;
+                    let packed = u16::from_be_bytes([row[offset], row[offset + 1]]);
+                    let component = |shift: u16| {
+                        let value = (packed >> shift) & 0x1f;
+                        ((value * 255 + 15) / 31) as u8
+                    };
+                    rgba.extend([component(10), component(5), component(0), u8::MAX]);
+                }
+            }
+        }
+        (1 | 2, swf::BitmapFormat::Rgb32) => {
+            let mut row = vec![0; width as usize * 4];
+            for y in 0..height {
+                decoder
+                    .read_exact(&mut row)
+                    .map_err(|_| Error::InvalidZlibCompression)?;
+                if y < region.y_min || y >= region.y_max {
+                    continue;
+                }
+                for output_x in 0..region.width() {
+                    let logical_x = region.x_min + output_x;
+                    let source_x = if flip_x { width - 1 - logical_x } else { logical_x };
+                    let offset = source_x as usize * 4;
+                    rgba.extend([
+                        row[offset + 1],
+                        row[offset + 2],
+                        row[offset + 3],
+                        if has_alpha { row[offset] } else { u8::MAX },
+                    ]);
+                }
+            }
+        }
+        (1 | 2, swf::BitmapFormat::ColorMap8 { num_colors }) => {
+            let color_count = usize::from(num_colors) + 1;
+            let palette_stride = if has_alpha { 4 } else { 3 };
+            let mut palette_data = vec![0; color_count * palette_stride];
+            decoder
+                .read_exact(&mut palette_data)
+                .map_err(|_| Error::InvalidZlibCompression)?;
+            let palette: Vec<Color> = palette_data
+                .chunks_exact(palette_stride)
+                .map(|entry| Color {
+                    r: entry[0],
+                    g: entry[1],
+                    b: entry[2],
+                    a: if has_alpha { entry[3] } else { u8::MAX },
+                })
+                .collect();
+            let padded_width = (width + 3) & !3;
+            let mut row = vec![0; padded_width as usize];
+            for y in 0..height {
+                decoder
+                    .read_exact(&mut row)
+                    .map_err(|_| Error::InvalidZlibCompression)?;
+                if y < region.y_min || y >= region.y_max {
+                    continue;
+                }
+                for output_x in 0..region.width() {
+                    let logical_x = region.x_min + output_x;
+                    let source_x = if flip_x { width - 1 - logical_x } else { logical_x };
+                    let color = palette
+                        .get(row[source_x as usize] as usize)
+                        .copied()
+                        .unwrap_or(if has_alpha {
+                            Color::TRANSPARENT
+                        } else {
+                            Color::BLACK
+                        });
+                    rgba.extend([color.r, color.g, color.b, color.a]);
+                }
+            }
+        }
+        _ => {
+            return Err(Error::UnsupportedLosslessFormat(
+                swf_tag.version,
+                swf_tag.format,
+            ));
+        }
+    }
+
+    tracing::info!(
+        "VITA_LOSSLESS_REGION_OK source={}x{} region={},{},{}x{} flip_x={} decoded_bytes={}",
+        width,
+        height,
+        region.x_min,
+        region.y_min,
+        region.width(),
+        region.height(),
+        flip_x,
+        rgba.len(),
+    );
+    Ok(Bitmap::new(
+        region.width(),
+        region.height(),
+        BitmapFormat::Rgba,
+        rgba,
+    ))
+}
