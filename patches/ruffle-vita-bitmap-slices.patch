+            let (_, tag_len) = tag_reader.read_tag_code_and_length().unwrap();
+            let tag_data = tag_reader.read_slice(tag_len).unwrap();
+
+            let eager = reader(tag_data).read_define_font_2(font_version).unwrap();
+            let lazy = reader(tag_data)
+                .read_define_font_2_lazy(font_version)
+                .unwrap();
+
+            assert_eq!(eager.version, lazy.version);
+            assert_eq!(eager.id, lazy.id);
+            assert_eq!(eager.name, lazy.name);
+            assert_eq!(eager.language, lazy.language);
+            assert_eq!(eager.layout, lazy.layout);
+            assert_eq!(eager.flags, lazy.flags);
+            assert_eq!(eager.glyphs.len(), lazy.glyphs.len());
+
+            for (eager_glyph, lazy_glyph) in eager.glyphs.iter().zip(&lazy.glyphs) {
+                assert_eq!(eager_glyph.code, lazy_glyph.code);
+                assert_eq!(eager_glyph.advance, lazy_glyph.advance);
+                assert_eq!(eager_glyph.bounds, lazy_glyph.bounds);
