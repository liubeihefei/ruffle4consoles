+#[cfg(target_os = "vita")]
+fn compress_vita_jpeg_region(rgba: &[u8]) -> Option<Vec<u8>> {
+    let mut encoder = ZlibEncoder::new(Vec::new(), Compression::fast());
+    encoder.write_all(rgba).ok()?;
+    encoder.finish().ok()
+}
+
+#[cfg(target_os = "vita")]
+fn decompress_vita_jpeg_region(entry: &VitaJpegRegionCacheEntry) -> Option<Vec<u8>> {
+    let mut rgba = Vec::with_capacity(entry.rgba_len);
+    ZlibDecoder::new(entry.compressed_rgba.as_slice())
+        .read_to_end(&mut rgba)
+        .ok()?;
+    (rgba.len() == entry.rgba_len).then_some(rgba)
+}
