+        {
+            return Ok(None);
+        }
+
+        ruffle_render::utils::register_define_bits_jpeg3_rows(
+            backend,
+            data.as_ref(),
+            alpha.data(),
+            u32::from(*width),
+            u32::from(*height),
+        )
+        .map(Some)
+    }
