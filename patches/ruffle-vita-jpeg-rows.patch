+    #[cfg(target_os = "vita")]
+    pub fn register_gpu(
+        &self,
+        backend: &mut dyn RenderBackend,
+    ) -> Result<Option<BitmapHandle>, RenderError> {
+        let CompressedBitmap::Jpeg {
+            data,
+            alpha: Some(alpha),
+            width,
+            height,
